# ==============================================================================
# 🏦 BANKPILOT TRANSACTION MCP SERVER - CONFIGURATION TEMPLATE
# ==============================================================================
# For GCP Cloud Run deployment or local development.
# Set these as environment variables in Cloud Run or in your local .env file.
# ==============================================================================

# 🌐 SERVER SETTINGS
PROJECT_NAME="BankPilot Transaction MCP Server"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8080
LOG_LEVEL="INFO"

# ☁️ GOOGLE CLOUD & BIGQUERY
GOOGLE_CLOUD_PROJECT=banking-agent-rag-mcp
GOOGLE_CLOUD_LOCATION=us-central1
BIGQUERY_DATASET=banking_data
CUSTOMER_IDENTITY_DATASET=customer_identity

# 🔐 RESEND EMAIL INTEGRATION (OTP DELIVERY)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="BankPilot <security@contact.souravmaiti.dev>"
ADMIN_EMAIL="souravmaiti1997@gmail.com"

# 🔗 MICROSERVICE INTEGRATION
IDENTITY_SERVICE_URL=http://localhost:8001

# 🛡️ TRANSACTION LIMITS & OTP POLICIES
DEFAULT_TRANSACTION_THRESHOLD=5000.0
MAX_TRANSACTION_LIMIT=100000.0
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
