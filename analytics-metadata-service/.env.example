# FastAPI & Service Configuration
PROJECT_NAME="BankPilot Analytics Metadata Service"
SERVICE_VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Google Cloud & BigQuery
GOOGLE_CLOUD_PROJECT="banking-agent-rag-mcp"
GOOGLE_CLOUD_LOCATION="us-central1"
BIGQUERY_DATASET="banking_data"
BIGQUERY_ANALYTICS_DATASET="analytics"
BIGQUERY_METADATA_DATASET="analytics_metadata"

# Authentication & API Keys
ADMIN_API_KEY="bankpilot-admin-secret-key"
ANALYTICS_COPILOT_API_KEY="bankpilot-analytics-copilot-key"
MOCK_AUTH_BYPASS=true
