# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Observability & Tracing Configuration
OTEL_TO_CLOUD=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# BigQuery Agent Analytics (Option 3)
BQ_ANALYTICS_DATASET_ID=analytics_copilot_telemetry
LOGS_BUCKET_NAME=your-gcp-project-id-logs-data

# AgentOps Observability & Session Replay (Option 4)
AGENTOPS_API_KEY=your-agentops-api-key-here

