# Google Cloud & BigQuery Configuration
GOOGLE_CLOUD_PROJECT=banking-agent-rag-mcp
GOOGLE_CLOUD_LOCATION=us-central1
BIGQUERY_DATASET=banking_data
BIGQUERY_VIEWS_DATASET=customer_views
BIGQUERY_ANALYTICS_DATASET=analytics
IDENTITY_DATASET=customer_identity
FIREBASE_SERVICE_ACCOUNT_PATH=
LOG_LEVEL=INFO

# Service Account for Deployment
DEPLOY_SERVICE_ACCOUNT=customer-identity-service-sa@banking-agent-rag-mcp.iam.gserviceaccount.com

# Resend Email Integration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="BankPilot <security@contact.souravmaiti.dev>"
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_EMAILS=your_admin_email@example.com

# RAG Engine & Knowledge Management Configuration
RAG_CORPUS_NAME=projects/your-project-id/locations/us-central1/ragCorpora/your-corpus-id
RAG_DOCUMENT_BUCKET=your-knowledge-bucket
RAG_LOCATION=us-central1
RAG_EMBEDDING_MODEL=publishers/google/models/text-embedding-004
